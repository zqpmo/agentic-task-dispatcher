{
  "name": "agentic-task-dispatcher",
  "version": "3.0.0",
  "description": "Deterministic multi-database task dispatcher with contract checks, idempotent writes, reconciliation, and dry-run by default",
  "main": "dist/controller.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/controller.js",
    "dev": "tsx src/controller.ts",
    "dry-run": "tsx src/controller.ts --dry-run",
    "execute": "tsx src/controller.ts --execute",
    "once": "tsx src/controller.ts --once",
    "reconcile": "tsx src/controller.ts --reconcile",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "notion",
    "automation",
    "deterministic",
    "idempotency",
    "workflow",
    "controller",
    "agentic-pmo"
  ],
  "license": "MIT",
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "fast-json-stable-stringify": "^2.1.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/fast-json-stable-stringify": "^2.0.0",
    "@types/node": "^22.8.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
